# Browser-safe values (NEXT_PUBLIC_*) go in .env.local. Never commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Neon Console > Data API > API URL (single-database form, without /rest/v1)
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-xxxx.apirest.ap-southeast-1.aws.neon.tech/neondb
# Clerk JWT template name that adds "role": "authenticated"
NEXT_PUBLIC_CLERK_NEON_JWT_TEMPLATE=neon

# Server/tooling only (migrations). NEVER prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
