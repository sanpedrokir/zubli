{
  "name": "zubli",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env.local scripts/db.mjs migrate",
    "db:seed": "node --env-file=.env.local scripts/db.mjs seed",
    "db:demo": "node --env-file=.env.local --env-file=.env.blob scripts/demo-seed.mjs",
    "db:demo:remove": "node --env-file=.env.local --env-file=.env.blob scripts/demo-seed.mjs --remove"
  },
  "dependencies": {
    "@clerk/react": "^6.18.6",
    "@neon/postgrest-js": "^0.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@vercel/blob": "^2.8.2",
    "exifr": "^7.1.3",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
